<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#FFF7F3"/>
      <stop offset="100%" stop-color="#FFFFFF"/>
    </linearGradient>
    <linearGradient id="thread" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#C2847D"/>
      <stop offset="100%" stop-color="#E8A89A"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="630" fill="url(#bg)"/>
  <g opacity="0.06">
    <circle cx="200" cy="100" r="300" fill="#C2847D"/>
    <circle cx="900" cy="500" r="250" fill="#C2847D"/>
  </g>
  <text x="600" y="260" font-family="Georgia, 'Times New Roman', serif" font-size="72" font-style="italic" fill="#C2847D" text-anchor="middle" letter-spacing="2">GTA Threads</text>
  <text x="600" y="330" font-family="Arial, sans-serif" font-size="28" fill="#6B6B6B" text-anchor="middle" font-weight="300" letter-spacing="4">GIFTS, STITCHED WITH LOVE</text>
  <line x1="480" y1="370" x2="720" y2="370" stroke="#C2847D" stroke-width="1" opacity="0.4"/>
  <text x="600" y="410" font-family="Arial, sans-serif" font-size="18" fill="#999" text-anchor="middle" font-weight="300" letter-spacing="2">HAND-EMBROIDERED IN TORONTO</text>
  <g transform="translate(600, 490)" opacity="0.15">
    <path d="M-30,0 Q-15,-30 0,-10 Q15,-30 30,0" fill="none" stroke="#C2847D" stroke-width="2"/>
    <circle cx="0" cy="-10" r="4" fill="#C2847D"/>
  </g>
</svg>
