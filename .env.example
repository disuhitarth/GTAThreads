# ─── Shopify (Storefront API — public, safe to ship to browser) ──────────────
# From Shopify Admin → Settings → Apps and sales channels → Develop apps →
# (your app) → API credentials → "Storefront API access token".
# Required scopes:
#   unauthenticated_read_product_listings
#   unauthenticated_read_product_inventory
#   unauthenticated_write_checkouts
#   unauthenticated_read_checkouts
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token
VITE_SHOPIFY_API_VERSION=2025-07

# ─── Site ────────────────────────────────────────────────────────────────────
# Absolute origin (no trailing slash). Used for canonical URLs, sitemap.xml,
# JSON-LD, and Open Graph tags. Set this to your production domain.
VITE_SITE_URL=https://www.your-domain.com

# ─── Chatbot / AI (server-only) ──────────────────────────────────────────────
# The "Care chat" uses an OpenAI-compatible endpoint via src/lib/ai-gateway.server.ts.
# Pick ONE of the following setups (see README → "Chatbot AI key"):
#
# Option A — Keep using Lovable AI Gateway (cheapest path off Lovable):
LOVABLE_API_KEY=

# Option B — Swap to OpenAI directly (edit src/lib/ai-gateway.server.ts):
# OPENAI_API_KEY=

# Option C — Swap to Anthropic (edit src/lib/ai-gateway.server.ts):
# ANTHROPIC_API_KEY=

# ─── Future integrations (stubs exist, wire when ready) ──────────────────────
# Tracking API for the chatbot's "where is my order" answer:
# TRACKING_API_KEY=
# TRACKING_API_BASE_URL=
#
# Newsletter provider for the bloom-list signup form:
# KLAVIYO_PRIVATE_API_KEY=
# KLAVIYO_LIST_ID=
