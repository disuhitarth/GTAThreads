# ─── Shopify (Storefront API — public, safe to ship to browser) ──────────────
# From Shopify Admin → Settings → Apps and sales channels → Develop apps →
# (your app) → API credentials → "Storefront API access token".
# Required scopes:
#   unauthenticated_read_product_listings
#   unauthenticated_read_product_inventory
#   unauthenticated_write_checkouts
#   unauthenticated_read_checkouts
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token
VITE_SHOPIFY_API_VERSION=2026-04

# ─── Site ────────────────────────────────────────────────────────────────────
# Absolute origin (no trailing slash). Used for canonical URLs, sitemap.xml,
# JSON-LD, and Open Graph tags. Set this to your production domain.
VITE_SITE_URL=https://gtathreads.netlify.app

# ─── Chatbot / AI (server-only) ──────────────────────────────────────────────
# Free: sign up at https://console.groq.com → get API key (no credit card needed).
# Model: llama-3.3-70b-versatile (30 req/min free tier)
GROQ_API_KEY=

# ─── Shopify Admin API (Newsletter + admin features) ──────────────────────────
# From Shopify Admin → Settings → Apps and sales channels → Develop apps →
# (your app) → API credentials → Admin API access token.
# Required scope: write_customers (for newsletter signups)
# - For newsletter: create a customer record with email + accepts_marketing: true.
# - Subscribers appear in Shopify Admin → Customers, ready for Shopify Email campaigns.
# SHOPIFY_ADMIN_TOKEN=

# ─── Sentry (Error Monitoring) ───────────────────────────────────────────────
# Free tier: 5,000 events/month.
# Get your DSN from https://sentry.io → Create Project → React
SENTRY_DSN=

# ─── Google Places API (Reviews) ─────────────────────────────────────────────
# Free: $200/month credit — more than enough for a small studio.
# Get API key from https://console.cloud.google.com → APIs → Places API
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ─── Judge.me (Product Reviews) ───────────────────────────────────────────────
# Free forever plan. Install from Shopify App Store.
# Get API credentials from Judge.me → Settings → API
JUDGEME_API_TOKEN=
JUDGEME_API_SECRET=

# ─── Shipping Tracking (Optional) ────────────────────────────────────────────
# For the chatbot's "where is my order?" feature.
# Provider: AfterShip, Shippo, EasyPost, or 17track
TRACKING_API_KEY=
TRACKING_API_BASE_URL=
